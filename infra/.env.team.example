# Copy to infra/.env.team. Never commit the filled file.
SPRING_BIND_ADDRESS=127.0.0.1
SPRING_HOST_PORT=18080
FASTAPI_BIND_ADDRESS=127.0.0.1
FASTAPI_HOST_PORT=18000
IMAGE_TAG=team-db

# Obtain these values from the PostgreSQL owner. Do not paste secrets into chat.
DB_HOST=CHANGE_ME_TEAM_DB_HOST
DB_PORT=5432
DB_NAME=PEZTZ
DB_USERNAME=CHANGE_ME_TEAM_DB_USER
DB_PASSWORD=CHANGE_ME_TEAM_DB_PASSWORD
DB_SSLMODE=require
DB_CONNECT_TIMEOUT_SECONDS=10

# Add the local and deployed frontend origins that will call Spring.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate three independent values with: openssl rand -hex 32
PEZTZ_INTERNAL_API_KEY=CHANGE_ME_SPRING_INTERNAL_KEY
FASTAPI_INTERNAL_API_KEY=CHANGE_ME_FASTAPI_INTERNAL_KEY
DEVICE_API_KEY=CHANGE_ME_DEVICE_KEY

OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1
FASTAPI_REPORT_CONNECT_TIMEOUT_MILLIS=5000
FASTAPI_REPORT_READ_TIMEOUT_MILLIS=200000

# Keep this false through the first real-data E2E test. Enable it only after the
# selected pet/date has been checked and the team approves automatic generation.
DAILY_REPORT_SCHEDULING_ENABLED=false
DAILY_REPORT_SCHEDULE_CRON="0 10 0 * * *"
DAILY_REPORT_TIME_ZONE=Asia/Seoul
DAILY_REPORT_RETRY_AFTER_MINUTES=10
DAILY_REPORT_GENERATION_LEASE_SECONDS=210
DAILY_REPORT_GENERATION_WAIT_SECONDS=220
DAILY_REPORT_GENERATION_POLL_MILLIS=500

# Camera/SmartThings settings are optional for report-only verification.
MEDIAMTX_PLAYBACK_BASE_URL=http://127.0.0.1:8889
MEDIAMTX_STREAM_PATH=cage-a1
MEDIAMTX_STREAM_PATH_TEMPLATE=camera-{camera_id}
SMARTTHINGS_ACCESS_TOKEN=
SMARTTHINGS_LOCATION_ID=
SMARTTHINGS_POLLING_ENABLED=false
