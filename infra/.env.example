# Use 18080 and 18000 while the existing systemd services are running.
# The production workflow requires 0.0.0.0 with ports 8080 and 8000.
SPRING_BIND_ADDRESS=127.0.0.1
SPRING_HOST_PORT=18080
FASTAPI_BIND_ADDRESS=127.0.0.1
FASTAPI_HOST_PORT=18000
IMAGE_TAG=local

# CI overrides these with commit-specific image names during production deploys.
# SPRING_IMAGE=peztz-spring:COMMIT_SHA
# FASTAPI_IMAGE=peztz-fastapi:COMMIT_SHA

# PostgreSQL installed on the GCP host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=PEZTZ
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# FastAPI -> Spring and Spring -> FastAPI authentication keys.
PEZTZ_INTERNAL_API_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
FASTAPI_INTERNAL_API_KEY=CHANGE_ME_WITH_ANOTHER_OPENSSL_RAND_HEX_32
DEVICE_API_KEY=CHANGE_ME_WITH_ANOTHER_OPENSSL_RAND_HEX_32

MEDIAMTX_PLAYBACK_BASE_URL=http://GCP_PUBLIC_IP:8889
MEDIAMTX_STREAM_PATH=cage-a1
MEDIAMTX_STREAM_PATH_TEMPLATE=camera-{camera_id}

SMARTTHINGS_BASE_URL=https://api.smartthings.com/v1
# Development/demo PAT only. Keep this file blank and put the real value in
# infra/.env. Newly issued PATs expire after 24 hours.
SMARTTHINGS_ACCESS_TOKEN=
# Keep polling disabled until the Station and both sensors are online.
SMARTTHINGS_POLLING_ENABLED=false
SMARTTHINGS_POLLING_INTERVAL_MS=60000
SMARTTHINGS_LOW_LIGHT_THRESHOLD_LUX=50

# Configure only the key used by the deployed Gemini client.
GEMINI_API_KEY=
GOOGLE_API_KEY=
