# Use 18080 and 18000 while the existing systemd services are running.
# Change them to 8080 and 8000 only during the final cutover.
SPRING_HOST_PORT=18080
FASTAPI_HOST_PORT=18000
IMAGE_TAG=local

# PostgreSQL installed on the GCP host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=PEZTZ
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# FastAPI -> Spring and Spring -> FastAPI authentication keys.
PEZTZ_INTERNAL_API_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
FASTAPI_INTERNAL_API_KEY=CHANGE_ME_WITH_ANOTHER_OPENSSL_RAND_HEX_32
DEVICE_API_KEY=CHANGE_ME_WITH_ANOTHER_OPENSSL_RAND_HEX_32

MEDIAMTX_PLAYBACK_BASE_URL=http://GCP_PUBLIC_IP:8889
MEDIAMTX_STREAM_PATH=cage-a1
MEDIAMTX_STREAM_PATH_TEMPLATE=camera-{camera_id}

SMARTTHINGS_BASE_URL=https://api.smartthings.com/v1
SMARTTHINGS_ACCESS_TOKEN=

# Configure only the key used by the deployed Gemini client.
GEMINI_API_KEY=
GOOGLE_API_KEY=
