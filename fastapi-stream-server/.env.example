SPRING_BOOT_BASE_URL=http://127.0.0.1:8080
SPRING_INTERNAL_API_KEY=CHANGE_ME
DEVICE_API_KEY=CHANGE_ME
FASTAPI_INTERNAL_API_KEY=CHANGE_ME

MEDIAMTX_API_BASE_URL=http://127.0.0.1:9997
MEDIAMTX_PLAYBACK_BASE_URL=http://127.0.0.1:8889
MEDIAMTX_STREAM_PATH=cage-a1
MEDIAMTX_STREAM_PATH_TEMPLATE=camera-{camera_id}

# Create a project key at https://platform.openai.com/api-keys.
# Put the real value only in fastapi-stream-server/.env, which Git ignores.
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1
